{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Real Invest Wallet",
  "version": "0.1.0",
  "identifier": "com.realinvest.wallet",
  "build": {
    "frontendDist": "../../nextjs/out",
    "devUrl": "http://localhost:8001",
    "beforeDevCommand": "pnpm --filter wallet-native dev",
    "beforeBuildCommand": "pnpm --filter wallet-native build"
  },
  "app": {
    "windows": [
      {
        "title": "Real Invest Wallet",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
