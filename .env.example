DATABASE_URL=file:./wallet.db
DATABASE_AUTH_TOKEN=
# Wallet origin for local development (Caddy local domain)
AUTH_URL=https://local.wallet.realinvest.com
AUTH_SECRET=replace-with-a-random-base64-secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Public HTTPS wallet API origin. Required by static Capacitor/Tauri builds.
NEXT_PUBLIC_API_URL=https://wallet.example.com
